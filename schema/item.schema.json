{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/vocabulary-review/item.schema.json",
  "title": "Review item (CLAUDE.md sections 4, 12.3 and 12.7)",
  "description": "One line of review/items/<export>.jsonl, review/gold/<export>.jsonl or review/queues/<export>/<queue>.jsonl. Fields beyond these are kept in the item's curation object by the loader.",
  "type": "object",
  "required": ["item_id", "vocabulary", "export_version", "construct_label", "construct_definition"],
  "properties": {
    "item_id": {"type": "string", "minLength": 5},
    "vocabulary": {"enum": ["scv", "rvv"]},
    "export_version": {"type": "string", "minLength": 1},
    "queue": {"enum": ["placement", "membership", null]},
    "construct_pid": {"type": ["string", "null"]},
    "construct_pids": {"type": "array", "items": {"type": "string"}},
    "construct_label": {"type": "string"},
    "construct_definition": {"type": ["string", "null"]},
    "construct_exclusions": {"type": ["string", "null"]},
    "construct_definition_provenance": {"type": ["string", "null"]},
    "measure_pid": {"type": ["string", "null"]},
    "programme": {"type": ["string", "null"]},
    "waves": {"type": ["string", "null"]},
    "question_text": {"type": ["string", "null"]},
    "question_text_en": {"type": ["string", "null"]},
    "text_kind": {"type": ["string", "null"]},
    "response_categories": {"type": ["array", "null"]},
    "universe_text": {"type": ["string", "null"]},
    "anchor_measure_pid": {"type": ["string", "null"]},
    "anchor_question_text": {"type": ["string", "null"]},
    "anchor_response_categories": {"type": ["array", "null"]},
    "grade": {"enum": ["identical", "equivalent", "related", "distinct", null]},
    "grade_reasons": {"type": ["object", "null"]},
    "method": {"type": ["string", "null"]},
    "model_confidence": {"type": ["number", "null"]},
    "neighbour_constructs": {"type": "array", "maxItems": 5,
      "items": {"type": "object", "required": ["pid", "label"], "properties": {"pid": {"type": "string"}, "label": {"type": "string"}}}},
    "stratum": {"type": "object"},
    "context": {"type": "object"},
    "is_gold": {"type": "boolean"},
    "gold_belongs": {"enum": ["yes", "no", "unsure", null]},
    "gold_grade": {"enum": ["identical", "equivalent", "related", "distinct", null]},
    "gold_source": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"queue": {"const": "membership"}}, "required": ["queue"]},
     "then": {"required": ["construct_pids", "members", "note"]},
     "else": {"required": ["construct_pid", "measure_pid", "programme", "stratum", "neighbour_constructs"]}}
  ]
}
